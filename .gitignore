.env
.env.*
!.env.example

.DS_Store
*.swp
*.swo
*~

# Klipper auto-rotated config backups on Pi (printer-YYYYMMDD_HHMMSS.cfg) — never copied into repo
printer-2*.cfg
mmu-2*

# Logs and run-time state from the Pi (not config)
klippy.log
moonraker.log
crowsnest.log
sonar.log
*.bak

# Per-run output from chopper-resonance-tuner (~700 MB possible per session)
config/adxl_results/

# Experiment / data output (e.g., park-sag CSVs from scripts/park_sag_experiment.py)
data/

# Deploy-script state files (not config) — written by scripts/deploy_to_pi.sh
config/.last-deploy-sha
config/.moonraker.conf.bkp

# Local working scratch
_pull_staging/
/tmp_*

# Vendored doc/source submodules — git tracks the submodule pointer, not contents
# (No need to ignore vendor/ — submodules are explicit)

# Local git worktrees for feature isolation
.worktrees/

# Claude Code local state — session lock and EnterWorktree-managed worktrees
.claude/scheduled_tasks.lock
.claude/worktrees/

# Python virtualenv
.venv/
__pycache__/
*.pyc
