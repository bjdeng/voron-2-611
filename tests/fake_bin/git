#!/usr/bin/env bash
# Fake git. Reads FAKE_GIT_BRANCH, FAKE_GIT_DIRTY, FAKE_GIT_CACHED_DIRTY,
# FAKE_GIT_LOCAL_SHA, FAKE_GIT_REMOTE_SHA, FAKE_GIT_DIFF_FILES,
# FAKE_GIT_DIFF_ERROR, FAKE_LAST_DEPLOY_PRINTER_CFG, FAKE_GIT_SHOW_ERROR.
# Logs every call.
echo "git $*" >> "${FAKE_LOG_DIR:-/dev/stderr}"

case "$1 $2" in
  "rev-parse --quiet")
    # `git rev-parse --quiet --verify <sha>^{commit}` — used by drift-all to
    # verify the marker SHA exists in git history before staging a snapshot.
    if [[ "${FAKE_GIT_MARKER_KNOWN:-1}" == "1" ]]; then exit 0; else exit 128; fi ;;
  "archive "*)
    # `git archive <sha> config/` — drift-all stages the marker commit
    # into a tmp dir via tar pipe. Tests that exercise the drift comparison
    # set FAKE_MARKER_TAR_PATH to a real tarball with `config/<files>`.
    # The companion FAKE_PI_FILE_HASHES controls the Pi side.
    if [[ "${FAKE_GIT_ARCHIVE_OK:-1}" != "1" ]]; then exit 128; fi
    if [[ -n "${FAKE_MARKER_TAR_PATH:-}" && -f "${FAKE_MARKER_TAR_PATH}" ]]; then
      cat "${FAKE_MARKER_TAR_PATH}"
      exit 0
    fi
    # Default: emit an empty config/ tar. snapshot_hashes will be empty,
    # which the drift function treats as "nothing to compare" → silent skip.
    local tmpdir; tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/config"
    tar -C "$tmpdir" -c config/
    rm -rf "$tmpdir"
    exit 0 ;;
  "branch --show-current") echo "${FAKE_GIT_BRANCH:-main}"; exit 0 ;;
  "diff --quiet")
    if [[ "${FAKE_GIT_DIRTY:-0}" == "1" ]]; then exit 1; else exit 0; fi ;;
  "diff --cached")
    if [[ "${FAKE_GIT_CACHED_DIRTY:-0}" == "1" ]]; then exit 1; else exit 0; fi ;;
  "fetch --quiet") exit 0 ;;
  "rev-parse main") echo "${FAKE_GIT_LOCAL_SHA:-abc1234}"; exit 0 ;;
  "rev-parse origin/main") echo "${FAKE_GIT_REMOTE_SHA:-abc1234}"; exit 0 ;;
  "diff --name-only")
    # Simulate `git diff <unknown-sha> main` failing (corrupt deploy marker).
    if [[ "${FAKE_GIT_DIFF_ERROR:-0}" == "1" ]]; then exit 128; fi
    printf '%s\n' "${FAKE_GIT_DIFF_FILES:-config/macros/macros.cfg}"
    exit 0 ;;
  "show "*)
    # `git show <sha>:config/printer.cfg` — used by check_no_pi_drift to
    # compare Pi's body to the last-deployed commit's printer.cfg body.
    # FAKE_LAST_DEPLOY_PRINTER_CFG provides the content; if unset, fall back
    # to the real repo file so tests that don't set it get a valid reference.
    if [[ "${FAKE_GIT_SHOW_ERROR:-0}" == "1" ]]; then exit 128; fi
    if [[ -n "${FAKE_LAST_DEPLOY_PRINTER_CFG:-}" ]]; then
      printf '%s' "${FAKE_LAST_DEPLOY_PRINTER_CFG}"
    else
      # Default: return the real printer.cfg so the drift check passes for
      # tests that set FAKE_PI_PRINTER_CFG via _matching_pi_cfg().
      _repo_root="$(cd "$(dirname "$0")/../.." && pwd)"
      cat "$_repo_root/config/printer.cfg" 2>/dev/null \
        || { echo "fake git: show fallback: cannot find config/printer.cfg" >&2; exit 128; }
    fi
    exit 0 ;;
  "status -sb")
    # Diagnostic call from check_tree_clean after detecting a dirty tree.
    # Real git would print the dirty files; the fake just needs to not blow up.
    exit 0 ;;
  *) echo "fake git: unhandled args: $*" >&2; exit 99 ;;
esac
