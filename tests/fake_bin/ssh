#!/usr/bin/env bash
echo "ssh $*" >> "${FAKE_LOG_DIR:-/dev/stderr}"

if [[ "${FAKE_SSH_REACHABLE:-1}" != "1" ]]; then
  exit 255
fi

# Heuristic: last arg is the remote command. Match on it.
# Use ${*: -1} (not ${@: -1}) to satisfy shellcheck: single positional as a
# string, not an array slice.
remote_cmd="${*: -1}"
case "$remote_cmd" in
  true) exit 0 ;;
  *find*-type*l*)
    if [[ "${FAKE_SSH_FIND_OK:-1}" != "1" ]]; then
      echo "find: cannot access '~/printer_data/config': No such file or directory" >&2
      exit 1
    fi
    printf '%s\n' "${FAKE_PI_SYMLINKS:-}" ;;
  *sed*SAVE_CONFIG*) printf '%s\n' "${FAKE_SAVE_CONFIG_BLOCK:-#*# <---------------------- SAVE_CONFIG ---------------------->}" ;;
  # Marker write: must match before the generic *last-deploy-sha* read pattern.
  # The script issues `echo '<sha>' > ~/printer_data/config/.last-deploy-sha`.
  *echo*\>*last-deploy-sha*)
    if [[ "${FAKE_MARKER_WRITE_OK:-1}" != "1" ]]; then exit 1; fi
    exit 0 ;;
  *cat*last-deploy-sha*) printf '%s' "${FAKE_LAST_DEPLOY_SHA:-}" ;;
  *cat*printer.cfg*) printf '%s' "${FAKE_PI_PRINTER_CFG:-}" ;;
  # Smoke-test helpers (L6, printer-smoke.sh).
  *stat*-c*klippy.log*wc*-l*klippy.log*)
    # Combined inode + line-count snapshot at start of smoke.
    # stat output first line, wc -l second.
    printf '%s\n%s\n' "${FAKE_KLIPPY_LOG_INODE:-12345}" "${FAKE_KLIPPY_LOG_LINES_BEFORE:-100}" ;;
  *stat*-c*klippy.log*)
    # Post-smoke inode re-check. Lets a test simulate log rotation by
    # setting FAKE_KLIPPY_LOG_INODE_AFTER different from BEFORE.
    printf '%s\n' "${FAKE_KLIPPY_LOG_INODE_AFTER:-${FAKE_KLIPPY_LOG_INODE:-12345}}" ;;
  *tail*klippy.log*grep*)
    # New-error scan. Returns whatever errors the test set up; empty by default.
    printf '%s' "${FAKE_KLIPPY_LOG_NEW_ERRORS:-}" ;;
  *) exit 0 ;;
esac
