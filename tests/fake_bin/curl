#!/usr/bin/env bash
echo "curl $*" >> "${FAKE_LOG_DIR:-/dev/stderr}"

url=""
for arg in "$@"; do
  case "$arg" in http*) url="$arg" ;; esac
done

case "$url" in
  *server/info)
    if [[ "${FAKE_MOONRAKER_REACHABLE:-1}" == "1" ]]; then exit 0; else exit 22; fi ;;
  *print_stats*)
    _default='{"result":{"status":{"print_stats":{"state":"standby"}}}}'
    printf '%s' "${FAKE_PRINT_STATS_JSON:-$_default}"
    exit 0 ;;
  *printer/info)
    _default_info='{"result":{"state":"ready","state_message":"Printer is ready"}}'
    printf '%s' "${FAKE_PRINTER_INFO_JSON:-$_default_info}"
    exit 0 ;;
  *printer/restart|*printer/firmware_restart)
    if [[ "${FAKE_RESTART_OK:-1}" == "1" ]]; then echo '{"result":"ok"}'; exit 0; else exit 1; fi ;;
  *printer/gcode/script)
    # L6 smoke: post a gcode script. Default success. Two failure modes:
    # - FAKE_GCODE_SCRIPT_OK=0 → reject every call (broken Moonraker).
    # - FAKE_GCODE_SCRIPT_FIRST_FAIL=1 → reject only the first call;
    #   subsequent calls succeed. Used to test the eddy-first-tap-flake
    #   retry path (#65, memory/eddy-first-tap-flake.md).
    counter_file="${FAKE_LOG_DIR%/*}/.gcode_script_count"
    n=$(( $(cat "$counter_file" 2>/dev/null || echo 0) + 1 ))
    [[ -n "${FAKE_LOG_DIR:-}" ]] && echo "$n" > "$counter_file"

    fail=0
    if [[ "${FAKE_GCODE_SCRIPT_OK:-1}" == "0" ]]; then
      fail=1
    elif [[ "${FAKE_GCODE_SCRIPT_FIRST_FAIL:-0}" == "1" && "$n" -eq 1 ]]; then
      fail=1
    fi

    if [[ "$fail" == "0" ]]; then
      echo '{"result":"ok"}'
      exit 0
    else
      echo '{"error":{"code":400,"message":"Klippy is not connected"}}' >&2
      exit 22
    fi ;;
  *) echo "fake curl: unhandled url: $url" >&2; exit 99 ;;
esac
